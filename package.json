{
  "name": "@zondax/ledger-js",
  "version": "0.0.0",
  "description": "TS / Node API for apps running on Ledger devices",
  "keywords": [
    "Zondax",
    "Ledger",
    "Typescript",
    "Javascript"
  ],
  "homepage": "https://github.com/Zondax/ledger-js",
  "bugs": {
    "url": "https://github.com/Zondax/ledger-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zondax/ledger-js.git"
  },
  "license": "Apache-2.0",
  "author": "Zondax AG",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "FORCE_COLOR=1 prettier --write . && sort-package-json",
    "format:check": "FORCE_COLOR=1 prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prepare": "tsc -p tsconfig.build.json",
    "test": "yarn build && jest",
    "typecheck": "tsc --noEmit",
    "upgrade": "bunx npm-check-updates -i"
  },
  "resolutions": {
    "glob": "^11.0.0"
  },
  "devDependencies": {
    "@ledgerhq/hw-transport-mocker": "^6.34.6",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/jest": "30.0.0",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "eslint-config-love": "^154.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^18.2.2",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "sort-package-json": "^4.0.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  },
  "volta": {
    "node": "20.11.1",
    "bun": "1.0.20"
  },
  "publishConfig": {
    "access": "public"
  },
  "moduleDirectories": [
    "node_modules",
    "dist"
  ]
}
